# API
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/resonance
# Optional AI features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional external model gateway. Implement endpoints compatible with the documented payloads in README.
MODEL_GATEWAY_URL=
MODEL_GATEWAY_TOKEN=
# Optional object storage for production uploads (local uploads are not persistent on ephemeral hosts)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=250
# Optional public URL used for review links
PUBLIC_APP_URL=http://localhost:5173

# Protect a deployed personal studio with a shared access password and a long random token secret
ACCESS_PASSWORD=change-this-before-deploying
TOKEN_SECRET=replace-with-a-long-random-secret
